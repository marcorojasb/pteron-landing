# Copia este archivo a .dev.vars para `npm run dev`. Nunca lo subas al repositorio.
# Las variables públicas (PUBLIC_SITE_URL, SUPABASE_URL, LICENSE_KID) viven en wrangler.jsonc.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Opcionales si los planes ya existen en Flow con otro id (por defecto pteron-<plan>-monthly):
# FLOW_BASIC_PLAN_ID=
# FLOW_PRO_PLAN_ID=
LICENSE_PRIVATE_KEY_PEM=
ANTHROPIC_API_KEY=
# Opcionales: GATEWAY_MODEL_ID (por defecto claude-haiku-5-5) y ANTHROPIC_BASE_URL.
# Correos que pueden entrar en /admin, separados por coma.
ADMIN_EMAILS=
