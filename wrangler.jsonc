{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pteron-landing",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // La web estática se sirve como assets; el Worker sólo atiende /api/* y el
  // fallback de /docs/:slug. drop-trailing-slash reproduce cleanUrls +
  // trailingSlash:false que tenía vercel.json; 404-page sirve public/404.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Variables públicas. Los secretos (SUPABASE_PUBLISHABLE_KEY,
  // SUPABASE_SERVICE_ROLE_KEY, FLOW_API_KEY, FLOW_SECRET_KEY,
  // LICENSE_PRIVATE_KEY_PEM, GATEWAY_UPSTREAM_API_KEY) se cargan con
  // `wrangler secret put` o desde el panel; nunca en este archivo.
  "vars": {
    "PUBLIC_SITE_URL": "https://pteron.patagua.dev",
    "SUPABASE_URL": "https://swzqblyllbudwbmbcthr.supabase.co",
    "LICENSE_KID": "k1"
  }
  // El dominio se asigna desde el panel al momento del corte (Custom Domains),
  // para no pisar el CNAME vigente con un deploy. Equivale a:
  // "routes": [{ "pattern": "pteron.patagua.dev", "custom_domain": true }]
}
