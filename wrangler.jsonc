{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pteron-landing",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // La web estática se sirve como assets; el Worker sólo atiende /api/* y el
  // fallback de /docs/:slug. drop-trailing-slash reproduce cleanUrls +
  // trailingSlash:false que tenía vercel.json; 404-page sirve public/404.html.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Sin esto, una navegación del navegador (Sec-Fetch-Mode: navigate) a una
    // ruta sin asset la responde el servidor de assets con la 404 y el Worker
    // nunca corre: el retorno de Flow a /api/billing/card-callback y los
    // enlaces directos a /docs/:slug se perderían. Estas rutas van al Worker
    // siempre; los archivos reales de /docs/* los sirve igual vía ASSETS.
    "run_worker_first": ["/api", "/api/*", "/docs/*"]
  },
  // Variables públicas. Los secretos (SUPABASE_PUBLISHABLE_KEY,
  // SUPABASE_SERVICE_ROLE_KEY, FLOW_API_KEY, FLOW_SECRET_KEY,
  // LICENSE_PRIVATE_KEY_PEM, ANTHROPIC_API_KEY, ADMIN_EMAILS, RESEND_API_KEY) se
  // cargan con `wrangler secret put` o desde el panel; nunca en este archivo.
  "vars": {
    "PUBLIC_SITE_URL": "https://pteron.patagua.dev",
    "SUPABASE_URL": "https://swzqblyllbudwbmbcthr.supabase.co",
    "LICENSE_KID": "k2",
    "GATEWAY_MODEL_ID": "claude-haiku-5-5",
    // Flow va aquí y no en el panel: cada despliegue reemplaza las variables de
    // texto del panel por las de este archivo. Sin FLOW_BASE_URL el Worker no
    // cobra, y en el sitio de producción sólo acepta la API de producción.
    "FLOW_BASE_URL": "https://www.flow.cl/api",
    // Flow fija el monto al crear un plan y no deja cambiarlo con suscriptores:
    // cada precio tiene su id. El checkout compara monto, moneda, intervalo y
    // urlCallback con plan_catalog y detiene la venta si algo no calza.
    "FLOW_BASIC_PLAN_ID": "pteron-basic-2990-mensual",
    "FLOW_PRO_PLAN_ID": "pteron-pro-9990-mensual",
    // Correos al cliente por Resend (src/lib/correo.js). Salen sólo con
    // RESEND_API_KEY (secreto, otra clave que la del SMTP de Supabase Auth),
    // EMAIL_FROM y los cuatro datos del vendedor: si falta cualquiera no se
    // envía nada y cada intento queda como evento <tipo>_email_skipped con los
    // nombres que faltan. EMAIL_FROM es el mismo remitente que ya usa Supabase
    // Auth; las respuestas del cliente llegan a SELLER_EMAIL (reply_to). Los
    // SELLER_* son los datos del vendedor, Patagua.dev SpA, según su
    // declaración de inicio de actividades ante el SII (LEGAL-PENDIENTE.md,
    // punto 1); el domicilio y el representante están por confirmar con Marco.
    // SELLER_REPRESENTATIVE es opcional y no detiene el envío: el representante
    // legal, que se dice sólo si vende una persona jurídica (Reglamento de
    // comercio electrónico, art. 7 n.º 6); una persona natural lo deja vacío.
    "EMAIL_FROM": "pteron <no-reply@patagua.dev>",
    "SELLER_NAME": "Patagua.dev SpA",
    "SELLER_RUT": "78.418.149-9",
    "SELLER_ADDRESS": "Fundo San Ricardo, Lote A y Lote B, Coronel, Región del Biobío",
    "SELLER_EMAIL": "hola@patagua.dev",
    "SELLER_REPRESENTATIVE": "Marco Antonio Rojas Belmar"
  },
  // Cron diario a las 12:17 UTC (09:17 en el verano de Chile, 08:17 en
  // invierno): sincroniza con Flow las suscripciones cerca del fin de lo pagado
  // y vence los checkouts abandonados (handler scheduled de src/worker.js).
  "triggers": { "crons": ["17 12 * * *"] },
  // Dominio de producción como Custom Domain: Cloudflare mantiene el registro
  // DNS y el certificado. El corte desde Vercel se hizo con este despliegue.
  "routes": [{ "pattern": "pteron.patagua.dev", "custom_domain": true }]
}
